# Azure App Service Deployment Configuration
# Project: VayuMitra (Urban Air Quality Assistant)
# Pattern: Single-Port Unified Full-Stack (TerraDetective model)

AZURE_RESOURCE_GROUP="niu_nw_25_0397_rg_9975"
AZURE_APP_SERVICE_PLAN="terradetective-plan"
AZURE_WEBAPP_NAME="vayumitra-demo"
AZURE_LOCATION="indiasouthcentral"
AZURE_RUNTIME="PYTHON:3.11"

# The backend serves both the API and the compiled React UI (frontend/dist) on port 8000
STARTUP_COMMAND="gunicorn --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --chdir backend app.main:app"
LIVE_APP_URL="https://vayumitra-demo.azurewebsites.net"
SWAGGER_DOCS_URL="https://vayumitra-demo.azurewebsites.net/docs"
