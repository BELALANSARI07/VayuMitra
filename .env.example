# === LLM Provider Configuration ===
# Options:
#   - "local" (Default): Uses Ollama running locally at http://localhost:11434 (zero cloud keys, 100% offline private)
#   - "gemini": Uses Google Gemini API (set LLM_API_KEY)
#   - "openai": Uses OpenAI API (set LLM_API_KEY)
#   - "deterministic": Embedded expert synthesis engine
LLM_PROVIDER=local
LLM_API_KEY=

# === Local Ollama Configuration ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3                     # e.g., llama3, qwen, mistral, phi3, gemma
OLLAMA_TIMEOUT_SECONDS=30.0

# === Cloud LLM Options (Optional) ===
LLM_MODEL_NAME=gemini-2.0-flash
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024

# === External AQI API Tokens ===
WAQI_API_TOKEN=                         # Optional fallback (Open-Meteo works without key)
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WX_BASE_URL=https://api.open-meteo.com/v1/forecast

# === Cache & Rate Limiting ===
AQI_CACHE_TTL_SECONDS=900
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=60

# === Security & CORS ===
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000", "https://vayumitra.vercel.app"]
DEBUG=false
